# ---- ParkSmart server configuration ----
# Copy this file to .env and fill in your values. Never commit .env (NFR-SEC-06).

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# "npm run db:setup" creates the database if it does not exist.
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/parksmart

# Long random string used to sign login tokens (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-secret

# Token lifetime — at most 8h (one gate shift, NFR-SEC-02)
JWT_EXPIRES_IN=8h

PORT=5000

# Where the React client runs. Used for CORS and for the URL inside ticket QR codes.
# Development: http://localhost:5173   Production (single server): http://localhost:5000 or your domain
CLIENT_URL=http://localhost:5173

# bcrypt cost factor (>= 10, FR-AUTH-03)
BCRYPT_COST=10

# Optional SMTP for pass renewal reminder emails (FR-RES-07).
# Leave SMTP_HOST empty to print reminder emails to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ParkSmart <no-reply@parksmart.local>

# How often the reservation/pass scheduler runs (milliseconds)
SCHEDULER_INTERVAL_MS=20000
