{
  "name": "parksmart-server",
  "version": "1.0.0",
  "private": true,
  "description": "ParkSmart REST API + Socket.IO server",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:setup": "node src/db/setup.js",
    "db:reset": "node src/db/setup.js --reset",
    "test": "node --test tests/unit/ tests/integration/",
    "test:unit": "node --test tests/unit/",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/services/feeEngine.js --test-coverage-include=src/utils/*.js tests/unit/",
    "lint": "eslint src tests",
    "test:integration": "node --test --test-concurrency=1 tests/integration/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "socket.io-client": "^4.8.1"
  }
}
